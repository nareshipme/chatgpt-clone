# Copy to .env (git-ignored) and fill in. Never commit real keys.
LLM_PROVIDER=poe                    # poe | mock
POE_API_KEY=
POE_BASE_URL=https://api.poe.com/v1
POE_MODEL=claude-sonnet-5.5          # Poe model ids are lowercase (GET /v1/models); pick one that supports tools
LLM_MAX_TOOL_ROUNDS=4
LLM_REQUEST_TIMEOUT_S=60

DATABASE_URL=postgresql+asyncpg://chat:chat@db:5432/chat
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000
