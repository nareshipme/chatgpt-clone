# Copy to .env (git-ignored) and fill in. Never commit real keys.
LLM_PROVIDER=openai_compatible      # openai_compatible | mock (mock is dev/tests only; refused in production)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=poolside/laguna-s-2.1:free  # keep ':free' ids on OpenRouter free tier
LLM_MAX_TOOL_ROUNDS=4
LLM_REQUEST_TIMEOUT_S=60

DATABASE_URL=postgresql+asyncpg://chat:chat@db:5432/chat
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000
