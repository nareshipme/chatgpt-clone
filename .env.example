# Copy to .env (git-ignored) and fill in. Never commit real keys.
# `docker compose up` works without a .env: it defaults to the mock assistant and a development-only JWT secret.

# --- Language model -------------------------------------------------------------------------------------
# mock: offline and deterministic (local development and tests only; the app refuses to start with it in production)
# openai_compatible: any OpenAI-style API (OpenRouter, Poe, Gemini, Groq...) using the three settings below
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=poolside/laguna-s-2.1:free   # keep ':free' ids on OpenRouter's free tier
LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=5                      # patience with 429s from free tiers (same model, backoff)
LLM_MAX_TOOL_ROUNDS=6                  # model -> tools -> model loops allowed per reply
LLM_MAX_HISTORY_MESSAGES=40

# --- Data stores ------------------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://chat:chat@db:5432/chat   # postgresql:// URLs are accepted too (Railway style)
REDIS_URL=redis://redis:6379/0

# --- Auth and web -----------------------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string   # required, no default in the app: a missing secret fails loudly
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false                    # true in production (HTTPS only)
CORS_ORIGINS=http://localhost:3000

# --- Copilot ----------------------------------------------------------------------------------------------
ACTION_EXPIRY_MINUTES=30               # a proposed action not decided by then can no longer be approved
